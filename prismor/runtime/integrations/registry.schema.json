{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Prismor integration registry",
  "type": "object",
  "required": ["schema", "agents"],
  "properties": {
    "schema": { "const": "prismor.runtime.integrations.v1" },
    "agents": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/integration" }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "integration": {
      "type": "object",
      "required": ["id", "name", "kind", "surface", "status", "blocking"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "name": { "type": "string" },
        "kind": { "enum": ["coding-agent", "framework", "multiplexer"] },
        "surface": { "enum": ["hook-config", "sdk", "mcp", "rules-only", "http", "pass-through"] },
        "status": { "enum": ["shipped", "roadmap", "sweep-only"] },
        "blocking": { "enum": ["exit-2", "json-permission", "throw", "proxy-deny", "none", "client-side"] },
        "events": { "type": "array", "items": { "type": "string" } },
        "config_paths": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "normalizer": { "type": ["string", "null"] },
        "sweep_dir": { "type": "string" },
        "notes": { "type": "string" },
        "sources": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
